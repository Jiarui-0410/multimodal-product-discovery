# Docker Compose path to the catalog generated by scripts/prepare_catalog.py.
CATALOG_CSV_PATH=/data/image_validated.csv

# Optional ranking experiment overrides (defaults shown)
QUERY_WEIGHT=0.60
USER_WEIGHT=0.30
METADATA_WEIGHT=0.10
CANDIDATE_MULTIPLIER=10

# Applied by Spring Boot; the Python service independently enforces 20 MB.
MAX_IMAGE_SIZE=20MB
